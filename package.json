{
  "name": "axodus-institucional",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "allowScripts": {
    "esbuild@0.18.20 || 0.25.12 || 0.27.3 || 0.28.1": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true,
    "workerd@1.20260515.1 || 1.20260708.1": true
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "postinstall": "node scripts/patch-cloudflare-vite-plugin.mjs",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "dev:vercel": "node node_modules/next/dist/bin/next dev",
    "build": "bash scripts/build-verified.sh",
    "build:vercel": "node node_modules/next/dist/bin/next build --webpack",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "start:vercel": "node node_modules/next/dist/bin/next start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.12",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.44.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.1.4",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "Axodus — Site Institucional",
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000"
}
